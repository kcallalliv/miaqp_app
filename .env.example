# ------------------------------------------------------------------
# Storefront CAVI STORE — variables de entorno
# Copia este archivo a `.env.local` y completa los valores.
# Si NO configuras Medusa, el storefront usa el catálogo mock (demo).
# ------------------------------------------------------------------

# URL del backend Medusa (Store API). Ej: http://localhost:9000
MEDUSA_BACKEND_URL=

# Publishable API key de Medusa (se crea en el admin o con el seed).
# Empieza con pk_...
MEDUSA_PUBLISHABLE_KEY=

# Region ID para calcular precios en la moneda correcta (PEN).
# Se obtiene del admin de Medusa o de la salida del seed. Empieza con reg_...
MEDUSA_REGION_ID=

# ------------------------------------------------------------------
# WhatsApp (canal de venta asistida y soporte)
# ------------------------------------------------------------------
# Número en formato internacional sin '+' ni espacios. Perú: 51XXXXXXXXX
NEXT_PUBLIC_WHATSAPP_NUMBER=51966538608

# ------------------------------------------------------------------
# Culqi (pasarela de pago)
# Sin estas claves, el checkout corre en MODO DEMO (pago simulado).
# ------------------------------------------------------------------
# Clave pública (cliente). Empieza con pk_test_... o pk_live_...
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# Clave privada (servidor, NUNCA se expone al cliente). pk_ -> sk_
CULQI_SECRET_KEY=
