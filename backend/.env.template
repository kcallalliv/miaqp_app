# ------------------------------------------------------------------
# Backend Medusa v2 — CAVI STORE
# Copia a `.env` y ajusta los valores.
# ------------------------------------------------------------------

# PostgreSQL (obligatorio)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cavi_store

# Redis (opcional en dev; recomendado en producción para eventos/colas)
# REDIS_URL=redis://localhost:6379

# CORS — apunta al storefront y al admin
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Secretos (cámbialos en producción)
JWT_SECRET=cambia-esto
COOKIE_SECRET=cambia-esto

# Deshabilitar el panel admin al desplegar solo la API
DISABLE_MEDUSA_ADMIN=false
