{
  "name": "cavi-store-backend",
  "version": "1.0.0",
  "description": "Backend Medusa v2 para CAVI STORE (running, natación y endurance)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "medusa build",
    "dev": "medusa develop",
    "start": "medusa start",
    "seed:cavi": "medusa exec ./src/scripts/seed-cavi.ts",
    "db:migrate": "medusa db:migrate",
    "db:setup": "medusa db:create && medusa db:migrate"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.4.0",
    "@medusajs/cli": "2.4.0",
    "@medusajs/framework": "2.4.0",
    "@medusajs/medusa": "2.4.0",
    "@mikro-orm/core": "6.4.3",
    "@mikro-orm/knex": "6.4.3",
    "@mikro-orm/migrations": "6.4.3",
    "@mikro-orm/postgresql": "6.4.3",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.4.0",
    "@swc/core": "1.5.7",
    "@types/node": "^20.0.0",
    "typescript": "^5.6.2"
  }
}
